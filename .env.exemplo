# Avisos do agendador no Telegram (opcional)
# Opção 1: token no Keychain do macOS (recomendado)
TELEGRAM_KEYCHAIN_SERVICE=MangabaAIBot
# Opção 2: token direto aqui
# TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instagram (Reels de teste). Conta profissional ligada a uma Página do Facebook.
# Token com instagram_basic + instagram_content_publish; guarde no Keychain:
#   security add-generic-password -s Instagram -a INSTAGRAM_TOKEN -w 'TOKEN'
INSTAGRAM_KEYCHAIN_SERVICE=Instagram
INSTAGRAM_USER_ID=

# TikTok (Content Posting API). Segredo no Keychain:
#   security add-generic-password -s TikTok -a TIKTOK_CLIENT_SECRET -w 'SEGREDO'
TIKTOK_CLIENT_KEY=
TIKTOK_KEYCHAIN_SERVICE=TikTok
